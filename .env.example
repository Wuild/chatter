# Copy to .env and enter your CurseForge upload API token.
CURSEFORGE_TOKEN=

# Exact game versions listed on CurseForge, comma-separated.
# Forever, Burning Crusade Anniversary, Retail (matching Whispr.toc).
# Separate from the addon release version.
CURSEFORGE_GAME_VERSION=1.60.1,2.5.6,12.1.0

CURSEFORGE_PROJECT_ID=1727008

# Optional separate read API key for other CurseForge tools.
# See https://docs.curseforge.com/rest-api/ . Not needed for uploads.
CURSEFORGE_API_KEY=
